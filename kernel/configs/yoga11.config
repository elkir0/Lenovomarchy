# Lenovo Yoga Tab 11 (YT-J706F, MediaTek MT6785) project fragment.
#
# Merged by kernel/kbuild.sh on top of the previous run's .config
# (initially seeded from kernel/configs/pmos-mt6785.config, the
# postmarketOS config for this tree at Linux 6.16.4, carried to 7.1
# by make olddefconfig).  Every symbol below exists in the 7.1
# Kconfig files of src/mt6785-mainline.
#
# CONFIG_FB_SIMPLE, requested in the project brief, is deliberately
# absent: it depends on !DRM_SIMPLEDRM (drivers/video/fbdev/Kconfig),
# so it cannot be set together with CONFIG_DRM_SIMPLEDRM=y.  simpledrm
# (kept, as the tree's DRM stack is enabled and MT6785 display support
# comes through DRM) plus DRM fbdev emulation provides the same early
# framebuffer console.

# Early display and boot logs: simpledrm claims the bootloader frame
# buffer, the framebuffer console renders boot output on it, and
# pstore/ramoops recovers console and userspace logs after a crash
# (PSTORE_PMSG adds /dev/pmsg0).
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# SoC watchdog built in, so a hung kernel reboots the tablet.
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y

# systemd needs open_by_handle_at (FHANDLE) to run as PID 1.
CONFIG_FHANDLE=y

# Battery gauge (BQ27xxx over I2C) and the combo connectivity chip:
# MT7663 Wi-Fi over SDIO, MediaTek Bluetooth over SDIO.  The base
# postmarketOS config disables the whole MediaTek WLAN vendor menu,
# which gates MT7663S behind WLAN_VENDOR_MEDIATEK: re-enable it.
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7663S=m
CONFIG_BT_MTKSDIO=m

# MediaTek MMC (SDIO) and SPI hosts, and the CS35L41 I2C speaker amps.
CONFIG_MMC_MTK=y
CONFIG_SPI_MT65XX=y
CONFIG_SND_SOC_CS35L41_I2C=m

# USB gadget configfs with ECM/NCM (networking) and ACM (serial) for
# debugging over the USB cable.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y

# Display: the HX83102P panel (driver entry added in the yt11-panel series)
# and the KTZ8864A backlight + LCD bias, a register clone of TI LM36274
# (ti-lmu MFD, backlight and lm363x regulators), built in for an early
# picture.
CONFIG_DRM_PANEL_HIMAX_HX83102=y
CONFIG_MFD_TI_LMU=y
CONFIG_BACKLIGHT_LM36274=y
CONFIG_REGULATOR_LM363X=y

# MT6360 LDOs power the microSD and the SDIO Wi-Fi: built in so the MMC
# hosts probe from the initramfs.
CONFIG_REGULATOR_MT6360=y

# MT6785 audio front end (yt11-audio series); the tablet needs its own
# machine driver for the four CS35L41 amps, still to write.
CONFIG_SND_SOC_MT6785=m

# Stable release string, so the modules installed in the root image keep
# loading across kernel rebuilds (no -g<hash>/-dirty suffix).
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-yt11"

# Himax HX83102P touch and pen (zero-flash TDDI on SPI0). Its firmware,
# /lib/firmware/himax/hx83102p.bin, comes from the unit's own vendor
# partition (/vendor/firmware/Himax_firmware.bin), never from this repo.
CONFIG_TOUCHSCREEN_HIMAX_HX83102=m
CONFIG_TOUCHSCREEN_HIMAX_HX83102_SPI=m

# Sound card: MT6785 AFE + MT6359 codec machine driver, which also drives
# the four CS35L41 speaker amplifiers listed in the board DT.
CONFIG_SND_SOC_MT6785_MT6359=m
CONFIG_SND_SOC_MT6359=m
CONFIG_SND_SOC_MT6359_ACCDET=m

# Motion sensor: Bosch BMI220 accelerometer + gyroscope on SPI2 (bmi270
# driver). Its init data (bmi220-init-data.fw) is not redistributable.
CONFIG_BMI270_SPI=m

# Light sensor: Lite-On LTR-578ALS on i2c1 (ltrf216a driver).
CONFIG_LTRF216A=m

# cpuidle: the firmware hangs on every PSCI CPU_SUSPEND state; a WFI-only
# driver with an s2idle state lets suspend-to-idle freeze timekeeping.
CONFIG_ARM64_WFI_S2IDLE_CPUIDLE=y
