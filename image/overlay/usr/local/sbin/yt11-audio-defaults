#!/bin/sh
# Run by udev when the YT-J706F sound card appears (90-yt11-audio.rules).
#
# The playback front end (DL1, PCM device 0) is a DPCM front end: opening it
# fails with EINVAL while no back end is routed to it, so PipeWire's profile
# probe would find no usable profile. Route DL1 to the MT6359 DAC (the
# headphone path; nothing is audible while "HP Mux" stays open) so the PCM
# can be opened; the PipeWire port paths then switch between the DAC and the
# speaker amplifiers.
#
# The speaker amplifiers' I2S (I2S1 out, I2S2 feedback in) runs from the
# audio PLL in low-jitter mode, as the stock Android audio configuration
# keeps it.
card=${1:-0}
amixer -q -c "$card" cset name='ADDA_DL_CH1 DL1_CH1' on
amixer -q -c "$card" cset name='ADDA_DL_CH2 DL1_CH2' on
amixer -q -c "$card" cset name='I2S1_HD_Mux' Low_Jitter
amixer -q -c "$card" cset name='I2S2_HD_Mux' Low_Jitter
