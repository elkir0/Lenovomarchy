#!/bin/sh
# Run by udev when the YT-J706F sound card appears (90-yt11-audio.rules).
#
# The playback front end (DL1, PCM device 0) is a DPCM front end: opening it
# fails with EINVAL while no back end is routed to it, so PipeWire's profile
# probe would find no usable profile. Route DL1 to the MT6359 DAC (not wired
# to anything on this board, and silent while "HP Mux" stays open) so the PCM
# can be opened; the PipeWire speaker path then moves DL1 to the speaker
# amplifiers.
#
# The speaker amplifiers' I2S (I2S1 out, I2S2 feedback in) runs from the
# audio PLL in low-jitter mode, as the stock Android audio configuration
# keeps it.
#
# Speaker protection: when Lenovo's CS35L41 DSP firmware is installed
# (tools/amp-firmware.sh --install), load it on the four amplifiers and route
# their audio through it, as Android does (tweeters SPK1/SPK3, woofers
# SPK2/SPK4, each with its own tuning). Without the files the amplifiers keep
# the plain ASP path: a DSP without firmware would leave them silent.
card=${1:-0}
amixer -q -c "$card" cset name='ADDA_DL_CH1 DL1_CH1' on
amixer -q -c "$card" cset name='ADDA_DL_CH2 DL1_CH2' on
amixer -q -c "$card" cset name='I2S1_HD_Mux' Low_Jitter
amixer -q -c "$card" cset name='I2S2_HD_Mux' Low_Jitter

# Analog gain: 17 (17.5 dB) behind the protection firmware, as Android sets
# it; 10 (10.5 dB) without it. The PipeWire speaker path leaves it alone.
fw=/usr/lib/firmware/cirrus/cs35l41-dsp1-spk-prot-yt-j706f
dsp=0
for n in 1 2 3 4; do
	gain=10
	if [ -f "$fw.wmfw" ] && [ -f "$fw-spk$n.bin" ] &&
	   amixer -q -c "$card" cset name="SPK$n DSP1 Preload Switch" on &&
	   amixer -q -c "$card" cset name="SPK$n PCM Source" DSP; then
		gain=17
		dsp=1
	fi
	amixer -q -c "$card" cset name="SPK$n Analog PCM Volume" "$gain"
done

# With the firmware running, mainline hibernates an idle amplifier after 3 s
# (runtime PM). Waking it takes tens of milliseconds and now and then fails
# ("Wake failed, re-enter hibernate"), which leaves that amplifier silent for
# the whole next stream. Android never hibernates them (the stock device tree
# lacks cirrus,hibernate-enable): keep them out of runtime suspend too.
if [ "$dsp" = 1 ]; then
	for ctl in /sys/bus/i2c/drivers/cs35l41/*/power/control; do
		[ -e "$ctl" ] && echo on > "$ctl"
	done
fi
