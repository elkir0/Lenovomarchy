[Unit]
Description=Grow root ext4 filesystem to fill userdata partition on first boot
DefaultDependencies=no
After=systemd-remount-fs.service
Before=local-fs.target
ConditionPathExists=!/var/lib/lenovomarchy/rootfs-resized

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/lenovomarchy-resize-rootfs

[Install]
WantedBy=multi-user.target
