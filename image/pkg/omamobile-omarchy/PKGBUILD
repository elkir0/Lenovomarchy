# Lenovo Yoga Tab 11 (YT-J706F) build of omamobile-omarchy.
#
# Upstream is https://github.com/derekross/omarchy-mobile (it moved from
# github.com/omarchy-mobile/omarchy-mobile, which is gone); this recipe pins
# upstream commit c4623572be1c141d602cf99a83ae0bf9e3eea09c (omamobile-omarchy
# 0.1.48, 2026-11-16) by tarball and sha256, and takes the patch tool
# (bin/omamobile-omarchy-patches), lib/lock-pam, the libalpm hook, the
# tmpfiles rule and the test harness from that tree.
#
# The two series families (patches/ for Omarchy 4.5, legacy-4.0.6/ for 4.0.6)
# live in this directory, trimmed for a Wi-Fi-only tablet with no packaged
# kernel, plus two tablet patches (9000/9001). install/ and test/ are the
# tablet's. See docs/research/omamobile/M1-OMARCHY-PATCHES.md for every
# keep/drop decision and the upgrade plan.
#
# Built by image/tools/build-pkg whenever the archive of pkgver-pkgrel is
# missing from the local [lenovomarchy] repo (image/build-rootfs.sh does this
# automatically; the input/prebuilt/ archive of the 0.1.32 era is gone).
#
# Maintainer: Derek Ross <derek@ross.And> (upstream)
# Tablet port: Lenovomarchy (image/pkg/omamobile-omarchy)
pkgname=omamobile-omarchy
pkgver=0.1.48
pkgrel=2
pkgdesc='Omarchy Mobile patch series for the Lenovo Yoga Tab 11 (YT-J706F): touch lock and shell patches over /usr/share/omarchy, re-applied after every Omarchy upgrade'
arch=(any)
url='https://github.com/derekross/omarchy-mobile'
license=(MIT)
depends=(
  'omarchy>=4.0.6'
  bash
  python
  patch
  libarchive
  util-linux
)
checkdepends=(diffutils patch util-linux libarchive)
optdepends=('omamobile-shell: the tablet status bar, quick settings and home screen')
install=omamobile-omarchy.install

_commit=c4623572be1c141d602cf99a83ae0bf9e3eea09c
_tarball="omarchy-mobile-${_commit}.tar.gz"
source=(
  "${_tarball}::${url}/archive/${_commit}.tar.gz"
  omamobile-omarchy.install
)
sha256sums=(
  '892334c964e0389952bddfc9b36fc9c64b660c79cad49ca654709c45f63ae7bf'
  'SKIP'
)
noextract=("${_tarball}")

prepare() {
  bsdtar -xf "$srcdir/$_tarball" \
    "omarchy-mobile-${_commit}/packages/$pkgname"
  cd "$srcdir/omarchy-mobile-${_commit}/packages/$pkgname"
  [[ $(cat version) == "$pkgver" ]] || {
    echo "upstream version is not $pkgver" >&2
    return 1
  }
  # The unmodified upstream series must apply to the Omarchy versions it was
  # checked against, before the tablet overlay takes patches away: if these
  # counts drift after an upstream bump, re-do the tablet trim.
  local n4x=$(ls patches/*.patch | wc -l) n406=$(ls legacy-4.0.6/*.patch | wc -l)
  (( n4x == 29 && n406 == 29 )) || {
    echo "upstream series sizes changed (4.5: $n4x, 4.0.6: $n406; expected 29/29)" >&2
    echo "redo the tablet trim against the new upstream" >&2
    return 1
  }

  # The patch tool, lock-pam, the libalpm hook, the tmpfiles rule and the
  # licences come from upstream; everything else (both series, install,
  # .install, tests) is the tablet's, carried in this directory.
  rm -rf "$srcdir/pkgsrc-root"
  mkdir -p "$srcdir/pkgsrc-root"
  cp -a bin/omamobile-omarchy-patches lib/lock-pam \
        libalpm/95-omamobile-omarchy-patches.hook tmpfiles/omamobile-run.conf \
        LICENSE LICENSE.omarchy "$srcdir/pkgsrc-root/"
  mkdir -p "$srcdir/pkgsrc-root/bin" "$srcdir/pkgsrc-root/lib" \
           "$srcdir/pkgsrc-root/libalpm" "$srcdir/pkgsrc-root/tmpfiles"
  mv "$srcdir/pkgsrc-root/omamobile-omarchy-patches" "$srcdir/pkgsrc-root/bin/"
  mv "$srcdir/pkgsrc-root/lock-pam" "$srcdir/pkgsrc-root/lib/"
  mv "$srcdir/pkgsrc-root/95-omamobile-omarchy-patches.hook" "$srcdir/pkgsrc-root/libalpm/"
  mv "$srcdir/pkgsrc-root/omamobile-run.conf" "$srcdir/pkgsrc-root/tmpfiles/"
  cp -a "$startdir/patches" "$startdir/legacy-4.0.6" "$startdir/install" \
        "$startdir/omamobile-omarchy.install" "$startdir/version" "$startdir/test" \
        "$srcdir/pkgsrc-root/"
}

check() {
  # Upstream's test suite, adapted to the tablet tree (the tail of test/all
  # says what is not run here and why). GNU install(1) and util-linux
  # script(1)/setsid make parts of it Linux-only; the build container is
  # Arch Linux ARM, so they run there.
  cp -a "$srcdir/pkgsrc-root" "$srcdir/checktree"
  bash "$srcdir/checktree/test/all"
}

package() {
  "$srcdir/pkgsrc-root/install" "$pkgdir"
}
