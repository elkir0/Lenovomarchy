YT-J706F tablet: quick settings without the phone's tiles.

Drops mobile data, hotspot, torch, location, NFC, fingerprint and rotation
lock from the tile catalogue (the Wi-Fi tablet has no driven modem, GNSS,
flash LED, NFC or fingerprint sensor, Hotspot would take the only Wi-Fi
link, and there is no sensor daemon to lock), so they show neither in the
sheet nor under "Add tiles"; a saved layout that names them loses them
(sanitize() skips unknown ids). The default layout is the tablet's own
tiles. test/tiles-model.js follows: its catalog, default and available-list
assertions now say the tablet's. Against omarchy-mobile c462357
(omamobile-shell 0.2.133), packages/omamobile-shell (applied with patch -p1
in that directory).

diff --git a/plugins/omamobile.quicksettings/TilesModel.js b/plugins/omamobile.quicksettings/TilesModel.js
index 1b510df..865e2db 100644
--- a/plugins/omamobile.quicksettings/TilesModel.js
+++ b/plugins/omamobile.quicksettings/TilesModel.js
@@ -12,17 +12,15 @@
 var VERSION = 1
 
 // Every tile the sheet knows, in the order the "available" list shows them.
+// Lenovo Yoga Tab 11 (YT-J706F) Wi-Fi build (image/pkg/omamobile-shell): no
+// mobile data, hotspot, torch, location or NFC (the tablet's modem, GNSS,
+// flash LED and NFC are not driven, and Hotspot would drop the only Wi-Fi
+// link), no fingerprint sensor, and no rotation lock (no sensor daemon).
 var CATALOG = [
   { id: "wifi", label: "Wi-Fi" },
   { id: "bluetooth", label: "Bluetooth" },
-  { id: "mobile-data", label: "Mobile data" },
   { id: "airplane", label: "Airplane mode" },
-  { id: "hotspot", label: "Hotspot" },
   { id: "dnd", label: "Do not disturb" },
-  { id: "torch", label: "Torch" },
-  { id: "rotation-lock", label: "Rotation lock" },
-  { id: "location", label: "Location" },
-  { id: "nfc", label: "NFC" },
   { id: "battery-saver", label: "Battery saver" },
   { id: "dark-theme", label: "Dark theme" },
   { id: "night-light", label: "Night light" },
@@ -30,7 +28,6 @@ var CATALOG = [
   { id: "mic", label: "Microphone" },
   { id: "screenshot", label: "Screenshot" },
   { id: "screen-record", label: "Screen record" },
-  { id: "fingerprint", label: "Fingerprint" },
   { id: "keyboard", label: "Keyboard" },
   { id: "clipboard", label: "Clipboard" },
   { id: "dictation", label: "Dictation" }
@@ -40,11 +37,13 @@ var CATALOG = [
 // reached for most. Clipboard and Dictation close the second page: Omarchy
 // reaches them only by keyboard shortcut, so a tile is their touch path
 // (TOUCH-PLAN 1.12), and appending them leaves the first page as it was.
+// YT-J706F tablet: the tiles that work here only. Microphone, Screen record
+// and Screenshot stay under "Add tiles"; Stay awake is on in the image, and
+// turning it off would let the idle lock come up.
 var DEFAULT_LAYOUT = [
-  "wifi", "bluetooth", "dnd", "torch",
-  "mobile-data", "rotation-lock", "airplane", "location",
-  "battery-saver", "dark-theme", "night-light", "nfc",
-  "fingerprint", "keyboard", "clipboard", "dictation"
+  "wifi", "bluetooth", "dnd", "airplane",
+  "battery-saver", "dark-theme", "night-light", "keyboard",
+  "clipboard", "screenshot"
 ]
 
 var QUICK_COUNT = 4
