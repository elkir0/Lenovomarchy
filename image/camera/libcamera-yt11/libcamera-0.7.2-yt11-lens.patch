+
+	/*
+	 * If an algorithm (Af) changed the desired lens position in
+	 * context.activeState.lens.position, apply it now. The lens controls
+	 * are not part of the delayed sensor controls as the actuator has no
+	 * per-frame semantics; the algorithm accounts for the settling time
+	 * itself.
+	 */
+	setLensPosition(context_.activeState.lens.position);
+
+	if (context_.configuration.lens.present) {
+		const int32_t range = context_.configuration.lens.max -
+				      context_.configuration.lens.min;
+		const float pos = range > 0
+			? static_cast<float>(context_.activeState.lens.position -
+					     context_.configuration.lens.min) /
+			  range
+			: 0.0f;
+		metadata.set(controls::LensPosition, pos);
+	}
+
 	metadataReady.emit(frame, metadata);
 
 	/* Sanity check */
