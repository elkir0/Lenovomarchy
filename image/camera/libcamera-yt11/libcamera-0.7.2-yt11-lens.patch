 {
 	IPAFrameContext &frameContext = context_.frameContexts.alloc(frame);
 
+	/*
+	 * Apply the manual focus control directly, independently of any
+	 * algorithm: the Af algorithm may not be enabled in the tuning file,
+	 * and with AfModeManual the LensPosition control is the only way to
+	 * move the lens.
+	 */
+	const auto &lensPosition = controls.get(controls::LensPosition);
+	if (lensPosition.has_value() && context_.configuration.lens.present) {
+		const float pos = std::clamp(lensPosition.value(), 0.0f, 1.0f);
+		setLensPosition(context_.configuration.lens.min +
+				pos * (context_.configuration.lens.max -
+				       context_.configuration.lens.min));
+	}
+
 	for (const auto &algo : algorithms())
 		algo->queueRequest(context_, frame, frameContext, controls);
 }
 
+/*
+ * Move the lens to a driver position. The position is clamped to the range
+ * reported by the lens driver, and recorded in the IPA context so that the
+ * Af algorithm knows which position the statistics correspond to. Moving
+ * to the position the lens is already at is a no-op.
+ */
+void IPASoftSimple::setLensPosition(int32_t position)
+{
+	if (!context_.configuration.lens.present)
+		return;
+
+	position = std::clamp(position,
+			      context_.configuration.lens.min,
+			      context_.configuration.lens.max);
+
+	if (position == lensPositionApplied_)
+		return;
+
+	context_.activeState.lens.position = position;
+	lensPositionApplied_ = position;
+
+	ControlList lensCtrls(lensInfoMap_);
+	lensCtrls.set(V4L2_CID_FOCUS_ABSOLUTE, position);
+	setLensControls.emit(lensCtrls);
+
+	LOG(IPASoft, Debug) << "Lens position set to " << position;
+}
