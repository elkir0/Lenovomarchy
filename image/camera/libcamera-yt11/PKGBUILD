# libcamera rebuilt for the Lenovo Yoga Tab 11 (YT-J706F, MT6785).
#
# Based on the Arch Linux ARM PKGBUILD for libcamera 0.7.2-4
# (https://github.com/archlinuxarm/PKGBUILDs, extra/libcamera/PKGBUILD).
# Differences from the ALARM package:
#   - libcamera-0.7.2-simple-mt6785.patch adds this tablet's media device
#     driver name ("mt6785-cam") to the simple pipeline handler's
#     supportedDevices[] table with the software ISP enabled.
#   - libcamera-0.7.2-yt11-sensors.patch adds CameraSensorHelper and
#     CameraSensorProperties entries for the tablet's ov8856 and s5k4h7
#     sensors (gain model, black level, pixel size, test patterns, delays).
#   - libcamera-0.7.2-yt11-agc.patch lets the soft IPA's tuning file set
#     the auto-exposure speed and target; ov8856.yaml and s5k4h7.yaml are
#     this tablet's tuning files.
#   - libcamera-0.7.2-yt11-lens.patch drives the rear camera's focus
#     actuator from the simple pipeline (LensPosition control), and
#     libcamera-0.7.2-yt11-af.patch adds a contrast autofocus algorithm
#     to the soft IPA (AfMode, AfTrigger, AfState).
#   - Only the simple pipeline and the soft IPA are built, and the heavy
#     extras the tablet does not need (docs, GStreamer plugin, Python
#     bindings, lc-compliance) are disabled so `makepkg -s` on the tablet
#     pulls fewer build dependencies.
#   - The ALARM libpisp make-dependency and its -D rpi-awb-nn override are
#     dropped along with the rpi pipelines: no Raspberry Pi is involved.
#   - arch is aarch64 and the test suite (needs CLONE_NEWUSER/CLONE_NEWNET
#     in the build chroot) is skipped, as building happens directly on
#     the tablet.

pkgbase=libcamera
pkgname=(
  libcamera
  libcamera-ipa
  libcamera-tools
)
pkgver=0.7.2
pkgrel=4.4
pkgdesc="A complex camera support library for Linux, Android, and ChromeOS (YT-J706F simple pipeline + soft ISP)"
arch=(aarch64)
url="https://libcamera.org/"
_url=https://git.libcamera.org/libcamera/libcamera.git
license=(
  Apache-2.0
  CC0-1.0
  'GPL-2.0-only WITH Linux-syscall-note'
  GPL-2.0-or-later
  LGPL-2.1-or-later
  'GPL-2.0-or-later WITH Linux-syscall-note OR BSD-3-Clause'
  'GPL-2.0-or-later WITH Linux-syscall-note OR MIT'
)
makedepends=(
  cmake
  git
  libdrm
  libgcc
  libjpeg-turbo
  libstdc++
  libtiff
  libyaml
  libyuv
  meson
  python-jinja
  python-ply
  python-pyyaml
  qt6-base
  qt6-tools
  sdl2
  systemd
)
source=(
  "git+$_url#tag=v$pkgver"
  "$pkgbase-$pkgver-simple-mt6785.patch"
  "$pkgbase-$pkgver-yt11-sensors.patch"
  "$pkgbase-$pkgver-yt11-agc.patch"
  "$pkgbase-$pkgver-yt11-lens.patch"
  "$pkgbase-$pkgver-yt11-af.patch"
  "ov8856.yaml"
  "s5k4h7.yaml"
)
