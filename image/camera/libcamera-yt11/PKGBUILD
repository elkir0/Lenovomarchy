# libcamera rebuilt for the Lenovo Yoga Tab 11 (YT-J706F, MT6785).
#
# Based on the Arch Linux ARM PKGBUILD for libcamera 0.7.2-4
# (https://github.com/archlinuxarm/PKGBUILDs, extra/libcamera/PKGBUILD).
# Differences from the ALARM package:
#   - libcamera-0.7.2-simple-mt6785.patch adds this tablet's media device
#     driver name ("mt6785-cam") to the simple pipeline handler's
#     supportedDevices[] table with the software ISP enabled.
#   - libcamera-0.7.2-yt11-sensors.patch adds CameraSensorHelper and
#     CameraSensorProperties entries for the tablet's ov8856 and s5k4h7
#     sensors (gain model, black level, pixel size, test patterns, delays).
#   - Only the simple pipeline and the soft IPA are built, and the heavy
#     extras the tablet does not need (docs, GStreamer plugin, Python
#     bindings, lc-compliance) are disabled so `makepkg -s` on the tablet
#     pulls fewer build dependencies.
#   - The ALARM libpisp make-dependency and its -D rpi-awb-nn override are
#     dropped along with the rpi pipelines: no Raspberry Pi is involved.
#   - arch is aarch64 and the test suite (needs CLONE_NEWUSER/CLONE_NEWNET
#     in the build chroot) is skipped, as building happens directly on
#     the tablet.

pkgbase=libcamera
pkgname=(
  libcamera
  libcamera-ipa
  libcamera-tools
)
pkgver=0.7.2
pkgrel=4.2
pkgdesc="A complex camera support library for Linux, Android, and ChromeOS (YT-J706F simple pipeline + soft ISP)"
arch=(aarch64)
url="https://libcamera.org/"
_url=https://git.libcamera.org/libcamera/libcamera.git
license=(
  Apache-2.0
  CC0-1.0
  'GPL-2.0-only WITH Linux-syscall-note'
  GPL-2.0-or-later
  LGPL-2.1-or-later
  'GPL-2.0-or-later WITH Linux-syscall-note OR BSD-3-Clause'
  'GPL-2.0-or-later WITH Linux-syscall-note OR MIT'
)
makedepends=(
  cmake
  git
  libdrm
  libgcc
  libjpeg-turbo
  libstdc++
  libtiff
  libyaml
  libyuv
  meson
  python-jinja
  python-ply
  python-pyyaml
  qt6-base
  qt6-tools
  sdl2
  systemd
)
source=(
  "git+$_url#tag=v$pkgver"
  "$pkgbase-$pkgver-simple-mt6785.patch"
  "$pkgbase-$pkgver-yt11-sensors.patch"
)
sha512sums=('SKIP'
            '62fb7a6f50502e98ee2c5541ef1f4a04a713af3ed8eddf0d6b6471bf27146ef623f1fa3f0b9fa1b2c3ca08863c24eed9cebdbee089fb8c1fd1c681dec2d026ee'
            '8c649c7b47508b15df394e0ed1f63ca5662c19045d059b76746786b9e76857f284a7d3a94f92f3c14942cbe6f2169f711e44f348e8602a0d615ef067a073a694')
b2sums=('SKIP'
        '73f3399218201a8ce0358b8bc58ffeff57a5010a3cb6a48aa21f1509b2642a621cbacabfb34939b048d97760cd26fcd64b390ad0d525e16c4f020aa63ae4c62f'
        '9c57cd8ba76a5b761bfa0e1652ba2ccbac538b225affaa7ba323d81b23e5357d4b47a7e57027c671c470d38264363744ceeaf373844c9140ee10b853dc96f3fc')

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

prepare() {
  cd $pkgbase
  patch -Np1 < ../$pkgbase-$pkgver-simple-mt6785.patch
  patch -Np1 < ../$pkgbase-$pkgver-yt11-sensors.patch

  # add version, so that utils/gen-version.sh may rely on it
  printf "%s\n" "$pkgver" > .tarball-version
}

build() {
  local meson_options=(
    -D pipelines=simple
    -D ipas=simple
    -D v4l2=enabled
    -D test=false
    -D documentation=disabled
    -D gstreamer=disabled
    -D pycamera=disabled
    -D qcam=enabled
    -D lc-compliance=disabled
    -D rpi-awb-nn=disabled
    -D softisp-gpu=auto
    -D tracing=disabled
    -D werror=false
  )

  arch-meson $pkgbase build "${meson_options[@]}"
  meson compile -C build
}

package_libcamera() {
  depends=(
    glibc
    gnutls
    libcamera-ipa
    libelf
    libgcc
    libglvnd
    libstdc++
    libunwind
    libyaml
    libyuv
    sh
    systemd-libs libudev.so
  )
  optdepends=('libcamera-tools: for applications')
  provides=(libcamera.so libcamera-base.so)

  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/{BSD-3-Clause,Linux-syscall-note,MIT}.txt -t "$pkgdir/usr/share/licenses/$pkgname/"

  (
    cd "$pkgdir"
    _pick $pkgbase-ipa usr/lib/libcamera/
    _pick $pkgbase-tools usr/bin/{cam,libcamera-bug-report,qcam}
  )
}

package_libcamera-ipa() {
  pkgdesc+=" - signed IPA"
  license+=(BSD-2-Clause CC-BY-SA-4.0)

  depends=(
    glibc
    libcamera libcamera.so libcamera-base.so
    libgcc
    libstdc++
  )
  # stripping requires re-signing of IPA libs, so we do it manually
  options=(!strip)

  strip $pkgname/usr/lib/libcamera/*{.so,proxy}
  for _lib in $pkgname/usr/lib/libcamera/*.so; do
    $pkgbase/src/ipa/ipa-sign.sh "$(find $srcdir/build -type f -iname "*ipa-priv-key.pem")" "$_lib" "$_lib.sign"
  done
  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_libcamera-tools() {
  pkgdesc+=" - tools"
  license+=(BSD-2-Clause)

  depends=(
    glibc
    libcamera libcamera.so libcamera-base.so
    libdrm
    libevent
    libgcc
    libjpeg-turbo libjpeg.so
    libstdc++
    libtiff libtiff.so
    libyaml
    qt6-base
    sdl2
  )

  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
