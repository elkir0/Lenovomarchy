_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

prepare() {
  cd $pkgbase
  patch -Np1 < ../$pkgbase-$pkgver-simple-mt6785.patch
  patch -Np1 < ../$pkgbase-$pkgver-yt11-sensors.patch
  patch -Np1 < ../$pkgbase-$pkgver-yt11-agc.patch
  patch -Np1 < ../$pkgbase-$pkgver-yt11-lens.patch
  patch -Np1 < ../$pkgbase-$pkgver-yt11-af.patch
  patch -Np1 < ../$pkgbase-$pkgver-yt11-awb.patch
  patch -Np1 < ../$pkgbase-$pkgver-yt11-lsc.patch

  # add version, so that utils/gen-version.sh may rely on it
  printf "%s\n" "$pkgver" > .tarball-version
}

build() {
  local meson_options=(
    -D pipelines=simple
    -D ipas=simple
    -D v4l2=enabled
    -D test=false
    -D documentation=disabled
    -D gstreamer=disabled
    -D pycamera=disabled
    -D qcam=enabled
    -D lc-compliance=disabled
    -D rpi-awb-nn=disabled
    -D softisp-gpu=auto
    -D tracing=disabled
    -D werror=false
  )

  arch-meson $pkgbase build "${meson_options[@]}"
  meson compile -C build
}

package_libcamera() {
  depends=(
    glibc
    gnutls
    libcamera-ipa
    libelf
    libgcc
    libglvnd
    libstdc++
    libunwind
    libyaml
    libyuv
    sh
    systemd-libs libudev.so
  )
  optdepends=('libcamera-tools: for applications')
  provides=(libcamera.so libcamera-base.so)

  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/{BSD-3-Clause,Linux-syscall-note,MIT}.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 "$srcdir/ov8856.yaml" "$srcdir/s5k4h7.yaml" -t "$pkgdir/usr/share/libcamera/ipa/simple/"

  (
    cd "$pkgdir"
    _pick $pkgbase-ipa usr/lib/libcamera/
    _pick $pkgbase-tools usr/bin/{cam,libcamera-bug-report,qcam}
  )
}

package_libcamera-ipa() {
  pkgdesc+=" - signed IPA"
  license+=(BSD-2-Clause CC-BY-SA-4.0)

  depends=(
    glibc
    libcamera libcamera.so libcamera-base.so
    libgcc
    libstdc++
  )
  # stripping requires re-signing of IPA libs, so we do it manually
  options=(!strip)

  strip $pkgname/usr/lib/libcamera/*{.so,proxy}
  for _lib in $pkgname/usr/lib/libcamera/*.so; do
    $pkgbase/src/ipa/ipa-sign.sh "$(find $srcdir/build -type f -iname "*ipa-priv-key.pem")" "$_lib" "$_lib.sign"
  done
  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_libcamera-tools() {
  pkgdesc+=" - tools"
  license+=(BSD-2-Clause)

  depends=(
    glibc
    libcamera libcamera.so libcamera-base.so
    libdrm
    libevent
    libgcc
    libjpeg-turbo libjpeg.so
    libstdc++
    libtiff libtiff.so
    libyaml
    qt6-base
    sdl2-compat   # provides sdl2 (Arch Linux ARM has no plain sdl2)
  )

  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
