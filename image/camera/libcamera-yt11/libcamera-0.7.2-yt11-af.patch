+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Lenovomarchy contributors
+ *
+ * Contrast detection autofocus
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af();
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class ScanState {
+		Idle,
+		Coarse,
+		Fine,
+	};
+
+	void startScan(IPAContext &context);
+
+	/* Tuning parameters, with the compiled-in defaults. */
+	uint32_t coarseStep_;
+	uint32_t fineStep_;
+	uint32_t settleFrames_;
+	double retriggerRatio_;
+	uint32_t retriggerFrames_;
+
+	/* Current mode and reported state. */
+	int32_t afMode_;
+	int32_t afState_;
+
+	/* Scan state. */
+	ScanState scanState_;
+	uint32_t settleCounter_;
+	int32_t bestFocus_;
+	uint64_t bestSharpness_;
+	bool hasBest_;
+	int32_t fineMin_;
+	int32_t fineMax_;
+
+	/* Continuous mode retrigger bookkeeping. */
+	uint64_t focusSharpness_;
+	uint32_t retriggerCount_;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
