diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
new file mode 100644
index 0000000..d567b2f
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,286 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Lenovomarchy contributors
+ *
+ * Contrast detection autofocus
+ */
+
+#include "af.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+#include "control_ids.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+/*
+ * Lens movement step of the coarse sweep, in lens driver units. The default
+ * of 30 divides the typical 0-1023 range in ~34 measurements, which
+ * DW9718-class actuators settle between in a couple of frames.
+ */
+static constexpr uint32_t kDefaultCoarseStep = 30;
+
+/* Lens movement step of the fine sweep, in lens driver units. */
+static constexpr uint32_t kDefaultFineStep = 5;
+
+/*
+ * Number of statistics events to wait after a lens movement before
+ * measuring: statistics are computed once every 4 frames and the actuator
+ * needs about two frames to settle, so 2 events (~8 frames) cover both.
+ */
+static constexpr uint32_t kDefaultSettleFrames = 2;
+
+/*
+ * Continuous mode: retrigger a scan when the sharpness stays below this
+ * ratio of the sharpness measured at the focused position, for this many
+ * consecutive statistics events.
+ */
+static constexpr double kDefaultRetriggerRatio = 0.7;
+static constexpr uint32_t kDefaultRetriggerFrames = 3;
+
+Af::Af()
+	: coarseStep_(kDefaultCoarseStep), fineStep_(kDefaultFineStep),
+	  settleFrames_(kDefaultSettleFrames),
+	  retriggerRatio_(kDefaultRetriggerRatio),
+	  retriggerFrames_(kDefaultRetriggerFrames),
+	  afMode_(controls::AfModeManual), afState_(controls::AfStateIdle),
+	  scanState_(ScanState::Idle), settleCounter_(0), bestFocus_(0),
+	  bestSharpness_(0), hasBest_(false), fineMin_(0), fineMax_(0),
+	  focusSharpness_(0), retriggerCount_(0)
+{
+}
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	/*
+	 * Without a lens there is nothing to do; the algorithm stays idle
+	 * and no controls are declared.
+	 */
+	if (!context.configuration.lens.present)
+		return 0;
+
+	/*
+	 * Declare the modes this algorithm implements. AfModeContinuous is
+	 * included: it retriggers a scan when the sharpness drops and stays
+	 * low (see kDefaultRetriggerRatio). AfState is reported in the
+	 * request metadata only and is not declared as a settable control.
+	 */
+	const ControlValue afModeValues[] = {
+		ControlValue(static_cast<int32_t>(controls::AfModeManual)),
+		ControlValue(static_cast<int32_t>(controls::AfModeAuto)),
+		ControlValue(static_cast<int32_t>(controls::AfModeContinuous)),
+	};
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(afModeValues, afModeValues[0]);
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(controls::AfTriggerValues);
+
+	coarseStep_ = tuningData["coarseStep"].get<uint32_t>(kDefaultCoarseStep);
+	fineStep_ = tuningData["fineStep"].get<uint32_t>(kDefaultFineStep);
+	settleFrames_ = tuningData["settleFrames"].get<uint32_t>(kDefaultSettleFrames);
+	retriggerRatio_ =
+		tuningData["retriggerRatio"].get<double>(kDefaultRetriggerRatio);
+	retriggerFrames_ =
+		tuningData["retriggerFrames"].get<uint32_t>(kDefaultRetriggerFrames);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	if (!context.configuration.lens.present)
+		return 0;
+
+	afMode_ = controls::AfModeManual;
+	context.activeState.lens.afAuto = false;
+	afState_ = controls::AfStateIdle;
+	scanState_ = ScanState::Idle;
+	settleCounter_ = 0;
+	bestFocus_ = context.configuration.lens.min;
+	bestSharpness_ = 0;
+	hasBest_ = false;
+	focusSharpness_ = 0;
+	retriggerCount_ = 0;
+
+	return 0;
+}
+
+void Af::queueRequest(IPAContext &context, const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!context.configuration.lens.present)
+		return;
+
+	const auto &afMode = controls.get(controls::AfMode);
+	if (afMode.has_value() && afMode.value() != afMode_) {
+		afMode_ = afMode.value();
+		context.activeState.lens.afAuto =
+			afMode_ != controls::AfModeManual;
+
+		/* Any mode change cancels an in-progress scan. */
+		scanState_ = ScanState::Idle;
+		settleCounter_ = 0;
+		afState_ = controls::AfStateIdle;
+		retriggerCount_ = 0;
+	}
+
+	const auto &afTrigger = controls.get(controls::AfTrigger);
+	if (afTrigger.has_value() && afMode_ == controls::AfModeAuto) {
+		if (afTrigger.value() == controls::AfTriggerStart)
+			startScan(context);
+		else {
+			scanState_ = ScanState::Idle;
+			settleCounter_ = 0;
+			afState_ = controls::AfStateIdle;
+		}
+	}
+}
+
+void Af::startScan(IPAContext &context)
+{
+	if (scanState_ != ScanState::Idle)
+		return;
+
+	/* Start the coarse sweep at the far end of the range. */
+	scanState_ = ScanState::Coarse;
+	settleCounter_ = settleFrames_;
+	bestFocus_ = context.configuration.lens.min;
+	bestSharpness_ = 0;
+	hasBest_ = false;
+	retriggerCount_ = 0;
+	afState_ = controls::AfStateScanning;
+	context.activeState.lens.position = context.configuration.lens.min;
+	LOG(IPASoftAf, Debug) << "Coarse scan started";
+}
+
+void Af::process(IPAContext &context, const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!context.configuration.lens.present)
+		return;
+
+	metadata.set(controls::AfState, afState_);
+
+	if (!stats->valid)
+		return;
+
+	if (afMode_ == controls::AfModeManual)
+		return;
+
+	/* Wait for the lens to settle and the statistics to refresh. */
+	if (settleCounter_) {
+		settleCounter_--;
+		return;
+	}
+
+	/* Per unit of green level, so a brightness change is not a focus change. */
+	const uint64_t sharpness = stats->sharpness * 1000000 /
+				   std::max<uint64_t>(stats->sum_.g(), 1);
+	const int32_t position = context.activeState.lens.position;
+
+	LOG(IPASoftAf, Debug)
+		<< "frame " << frame << " focus " << position
+		<< " sharpness " << sharpness;
+
+	switch (scanState_) {
+	case ScanState::Idle:
+		/*
+		 * Continuous mode: retrigger a scan when the sharpness stays
+		 * well below the value measured when the last scan settled.
+		 * This catches both subject movement and scene changes.
+		 */
+		if (afMode_ == controls::AfModeContinuous && focusSharpness_) {
+			if (sharpness < retriggerRatio_ * focusSharpness_) {
+				retriggerCount_++;
+				if (retriggerCount_ >= retriggerFrames_) {
+					LOG(IPASoftAf, Debug)
+						<< "Continuous retrigger";
+					startScan(context);
+				}
+			} else {
+				retriggerCount_ = 0;
+			}
+		}
+		break;
+
+	case ScanState::Coarse:
+		if (!hasBest_ || sharpness > bestSharpness_) {
+			/* Still climbing: record the peak and step forward. */
+			bestSharpness_ = sharpness;
+			bestFocus_ = position;
+			hasBest_ = true;
+
+			if (position + coarseStep_ <= context.configuration.lens.max) {
+				context.activeState.lens.position =
+					position + coarseStep_;
+				settleCounter_ = settleFrames_;
+				break;
+			}
+		} else if (sharpness + sharpness / 10 >= bestSharpness_) {
+			/* Within 10% of the peak: keep scanning. */
+			if (position + coarseStep_ <= context.configuration.lens.max) {
+				context.activeState.lens.position =
+					position + coarseStep_;
+				settleCounter_ = settleFrames_;
+				break;
+			}
+		}
+
+		/*
+		 * The sharpness dropped significantly, or the near end of the
+		 * range was reached: the peak is behind us, refine around it.
+		 */
+		fineMin_ = std::max(context.configuration.lens.min,
+				    bestFocus_ - static_cast<int32_t>(coarseStep_));
+		fineMax_ = std::min(context.configuration.lens.max,
+				    bestFocus_ + static_cast<int32_t>(coarseStep_));
+		scanState_ = ScanState::Fine;
+		bestSharpness_ = 0;
+		hasBest_ = false;
+		context.activeState.lens.position = fineMin_;
+		settleCounter_ = settleFrames_;
+		LOG(IPASoftAf, Debug) << "Fine scan " << fineMin_ << "-" << fineMax_;
+		break;
+
+	case ScanState::Fine:
+		if (!hasBest_ || sharpness > bestSharpness_) {
+			bestSharpness_ = sharpness;
+			bestFocus_ = position;
+			hasBest_ = true;
+		}
+
+		if (position + fineStep_ <= fineMax_) {
+			context.activeState.lens.position = position + fineStep_;
+			settleCounter_ = settleFrames_;
+			break;
+		}
+
+		/* The sweep is complete: settle on the best position. */
+		scanState_ = ScanState::Idle;
+		context.activeState.lens.position = bestFocus_;
+		settleCounter_ = settleFrames_;
+		afState_ = hasBest_ ? controls::AfStateFocused
+				    : controls::AfStateFailed;
+		focusSharpness_ = bestSharpness_;
+		LOG(IPASoftAf, Debug)
+			<< "AF done, focus " << bestFocus_
+			<< " sharpness " << bestSharpness_;
+		break;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
