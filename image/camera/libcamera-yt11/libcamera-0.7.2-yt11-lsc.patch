+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Lenovomarchy contributors
+ *
+ * Radial lens shading correction
+ */
+
+#pragma once
+
+#include "libcamera/internal/matrix.h"
+#include "libcamera/internal/vector.h"
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Lsc : public Algorithm
+{
+public:
+	Lsc();
+	~Lsc() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+
+private:
+	/* One row per colour channel (red, green, blue): k1, k2, k3. */
+	Matrix<float, 3, 3> coefficients_;
+	/* Optical centre, as a fraction of the image width and height. */
+	Vector<float, 2> centre_;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
