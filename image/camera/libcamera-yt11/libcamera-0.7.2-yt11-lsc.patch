+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Lenovomarchy contributors
+ *
+ * Radial lens shading correction
+ */
+
+#include "lsc.h"
+
+#include <array>
+#include <errno.h>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftLsc)
+
+/*
+ * The lens shading correction multiplies each colour channel of the black
+ * level corrected raw values, before the white balance gains and the colour
+ * correction matrix, by
+ *
+ *   gain(r) = 1 + k1 * r^2 + k2 * r^4 + k3 * r^6
+ *
+ * clamped to [1, 4], where r is the distance from the optical centre divided
+ * by half the image diagonal, with square pixels (r = 1 in the corners when
+ * the centre is in the middle of the image). The tuning file gives the
+ * optical centre as a fraction of the image width and height, and the
+ * coefficients of each colour channel:
+ *
+ *   - Lsc:
+ *       centre: [ 0.5, 0.5 ]
+ *       red: [ k1, k2, k3 ]
+ *       green: [ k1, k2, k3 ]
+ *       blue: [ k1, k2, k3 ]
+ *
+ * The centre is optional and defaults to the middle of the image. A colour
+ * channel without coefficients is not corrected. Only the GPU debayer
+ * implements the correction.
+ */
+
+Lsc::Lsc()
+	: centre_({ 0.5f, 0.5f })
+{
+}
+
+int Lsc::init(IPAContext &context, const ValueNode &tuningData)
+{
+	if (tuningData.contains("centre")) {
+		auto centre = tuningData["centre"].get<Vector<float, 2>>();
+		if (!centre ||
+		    centre->x() < 0.0f || centre->x() > 1.0f ||
+		    centre->y() < 0.0f || centre->y() > 1.0f) {
+			LOG(IPASoftLsc, Error)
+				<< "Invalid 'centre', expected two values in [0, 1]";
+			return -EINVAL;
+		}
+
+		centre_ = *centre;
+	}
+
+	static constexpr std::array<const char *, 3> channels = {
+		"red", "green", "blue"
+	};
+	bool enabled = false;
+
+	for (unsigned int i = 0; i < channels.size(); i++) {
+		if (!tuningData.contains(channels[i]))
+			continue;
+
+		auto k = tuningData[channels[i]].get<Vector<float, 3>>();
+		if (!k) {
+			LOG(IPASoftLsc, Error)
+				<< "Invalid '" << channels[i]
+				<< "' coefficients, expected [ k1, k2, k3 ]";
+			return -EINVAL;
+		}
+
+		for (unsigned int j = 0; j < 3; j++)
+			coefficients_[i][j] = (*k)[j];
+
+		enabled = true;
+	}
+
+	if (!enabled) {
+		LOG(IPASoftLsc, Warning)
+			<< "No coefficients, lens shading correction disabled";
+		return 0;
+	}
+
+	context.lscEnabled = true;
+
+	LOG(IPASoftLsc, Debug)
+		<< "Centre " << centre_ << ", coefficients " << coefficients_;
+
+	return 0;
+}
+
+void Lsc::prepare([[maybe_unused]] IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  DebayerParams *params)
+{
+	params->lscCoefficients = coefficients_;
+	params->lscCentre = centre_;
+}
+
+REGISTER_IPA_ALGORITHM(Lsc, "Lsc")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
