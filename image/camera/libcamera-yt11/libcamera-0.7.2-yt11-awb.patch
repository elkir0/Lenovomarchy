+	/*
+	 * Clipped pixels read the same in every channel and pull the gains
+	 * towards 1: use the sums that leave them out, unless nearly the whole
+	 * picture is clipped.
+	 */
+	const bool unclipped = stats->awbPixels >= nPixels / 16;
+	const uint64_t offset = blackLevel *
+				(unclipped ? stats->awbPixels : nPixels);
